{{- if eq .chezmoi.os "android" }}
# Use Termux writable tmp since /tmp is owned by shell:shell (0771)
export TMPDIR="${TMPDIR:-$PREFIX/tmp}"

# oxlint-tsgolint has no android-arm64 binary; use linux-arm64 via wrapper
# https://github.com/oxc-project/tsgolint/issues/866
export OXLINT_TSGOLINT_PATH="$HOME/.local/bin/tsgolint"

# Use native Android dialogs for SSH/GPG passphrases (via termux-dialog)
export SSH_ASKPASS="$HOME/.local/bin/ssh-askpass-termux"
export SSH_ASKPASS_REQUIRE=force

# Skip uv's libc detection so it can find Termux's Bionic Python
# https://github.com/astral-sh/uv/issues/18285
# https://github.com/gtbuchanan/tooling/issues/51
export UV_LIBC=none
{{ end -}}

# Add user's private bin to PATH
[ -d "$HOME/bin" ] && PATH="$HOME/bin:$PATH"
[ -d "$HOME/.local/bin" ] && PATH="$HOME/.local/bin:$PATH"

{{- if eq .chezmoi.os "darwin" }}

# Add Homebrew to PATH early to override built-in tool versions
PATH="/opt/homebrew/bin:$PATH"

# Add Node 20 to PATH since it's excluded by default
PATH="$(brew --prefix node@20)/bin:$PATH"
{{- end }}

# Add mise shims for non-interactive contexts (interactive shells use
# `mise activate` from bashrc instead, which prepends real tool paths).
# Prepended last so mise-pinned tool versions win over system/Homebrew.
[ -d "$HOME/.local/share/mise/shims" ] && PATH="$HOME/.local/share/mise/shims:$PATH"

# Wrappers that must outrank the shim for the tool they wrap — a wrapper named
# after a mise-managed tool is only reachable ahead of that tool's shim.
#
# Its own directory rather than putting ~/.local/bin in front, which would
# change resolution for everything in there to win one name. Nothing collides
# today, but only because the tools that would are the ones disable_tools
# disables; a tool leaving that list later would start shadowing mise's copy
# from a PATH change made for something unrelated. This way the reordering
# reaches exactly what asked for it.
[ -d "$HOME/.local/bin/wrappers" ] && PATH="$HOME/.local/bin/wrappers:$PATH"
