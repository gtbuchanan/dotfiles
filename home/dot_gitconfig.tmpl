{{- /* Set in .chezmoi.yaml.tmpl, which also picks .signingkey's type to match.
   `get` so a config generated before sshsigning existed falls through to GPG
   instead of erroring under missingkey=error. */ -}}
{{- $sshSigning := get . "sshsigning" -}}
[alias]
	a = add
	aa = a -A
	ai = a -i
{{- if eq .chezmoi.os "windows" }}
	amt = !pwsh -File "~/{{ .codeDir }}/git-add-mergetool/git-add-mergetool.ps1"
{{- end }}
	ap = a -p
	b = branch
	ba = b -a
	bc = b --show-current
	br = b -lr
	bvv = b -vv
	c = commit
	cane = c --amend --no-edit
	cl = clean-safe
	clean-safe = !bash ~/.config/git/clean-safe
	cp = cherry-pick
	cpa = cp --abort
	cpc = cp --continue
	cpx = cp -x
	co = checkout
	d = diff
	ds = d --staged
	dt = difftool
	dts = dt --staged
	dtsy = dts -y
	dty = dt -y
	f = fetch
	fp = f --prune
{{- if eq .hosttype "ewn" }}
	j = !bash ~/.config/git/jira
	jc = j comment list
	jl = j link list
	jt = j transition
	jv = j view
{{- end }}
	l = log
	lol = l --format=oneline-detailed
	m = merge
	ma = m --abort
	mc = m --continue
	mt = mergetool
	p = pull --prune
	r = restore
	rb = rebase
	rba = rb --abort
	rbc = rb --continue
	rbi = rb -i
	rs = r --staged
	rpo = remote prune origin
	s = status
	sol = show -s --format=oneline-detailed
	ss = s -s
	sss = s --show-stash
	st = stash
	stl = st list
	stp = st -p
	sw = switch
	swc = sw -c
{{- if eq .hosttype "ewn" }}
	unpicked = !pwsh -File "~/{{ .codeDir }}/git-unpicked/git-unpicked.ps1" -Format "oneline-detailed"
{{- end }}
	unsynced = l --branches --not --remotes --no-walk --decorate --format=oneline-detailed
	wt = worktree
	wta = wt add
	wtl = wt list
	wtp = wt prune
	wtr = wt remove
	wtrf = wtr -f

[commit]
	gpgsign = true

[core]
{{- if eq .chezmoi.os "windows" }}
	autocrlf = true
	# Git Bash comes with its own version of Vim, but we want the Windows version
	editor = 'C:\\Program Files\\Vim\\vim92\\vim.exe'
	longpaths = true
{{- else }}
	editor = vim
{{- end }}
	pager = delta
{{- if eq .chezmoi.os "android" }}
	# Termux has a special command for ssh to ensure ssh-agent is running
	sshCommand = ssha
{{- end }}

[credential "https://github.com"]
	# Pin the GitHub account so Git Credential Manager uses it directly instead
	# of prompting to choose when several accounts are cached for github.com.
	username = gtbuchanan

[delta]
	dark = true
	hyperlinks = true
	line-numbers = true
	navigate = true
	side-by-side = true

[fetch]
	prune = true

[diff]
	colorMoved = zebra
	guitool = kdiff3

{{- if eq .chezmoi.os "windows" }}
[difftool "kdiff3"]
	path = C:\\Program Files\\KDiff3\\bin\\kdiff3.exe
{{- end }}

[gpg]
{{- if $sshSigning }}
	format = ssh
{{- end }}
{{- if eq .chezmoi.os "windows" }}
	# Kept under SSH signing too: Git picks the verification backend from the
	# signature, so this verifies the GPG-signed history predating the switch.
	program = {{ .chezmoi.homeDir }}/.config/git/gpg-wrapper.bat
{{- else if .wsl }}
	program = /mnt/c/Program Files/GnuPG/bin/gpg.exe
{{- end }}
{{- if $sshSigning }}

[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
	# Git for Windows prefers its bundled MSYS2 ssh-keygen, which can't reach
	# the Windows agent's named pipe. Point at the native client, matching the
	# GIT_SSH the winget manifest sets machine-wide.
	program = C:/Program Files/OpenSSH/ssh-keygen.exe
{{- end }}

[init]
	defaultBranch = main

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictStyle = zdiff3
	ff = only
	tool = kdiff3

{{- if eq .chezmoi.os "windows" }}
[mergetool "kdiff3"]
	path = C:\\Program Files\\KDiff3\\bin\\kdiff3.exe
{{- end }}

[pretty]
	oneline-detailed = %C(auto,yellow)%h%C(auto,magenta)%  %C(auto,blue)%>(12,trunc)%ar %C(auto,green)%<(10,trunc)%aN %C(auto,reset)%s%C(auto,blue)% (trailers:key=Fixes,key=Resolves,separator=%x2C)%C(auto)%d

[pull]
	ff = only
	rebase = true

[push]
	autoSetupRemote = true
	forceIfIncludes = true

[user]
	name = Taylor Buchanan
	email = {{ .email | quote }}
	signingkey = {{ if $sshSigning }}key::{{ end }}{{ .signingkey }}
