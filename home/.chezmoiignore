{{- if ne .chezmoi.os "windows" }}
.chezmoiscripts/windows/**
AppData
Documents
**/*.bat*
.local/bin/coderabbit
.local/bin/wt.exe
.psmux
.wslconfig
{{- else }}
.gnupg
# On Windows, symlink_ creates file symlinks; use a script for directory symlinks
.claude/skills
{{- end }}

{{- if ne .chezmoi.os "android" }}
.chezmoiscripts/android/**
.config/mise
.local/bin/bw-session-termux
.local/bin/pinentry-termux
.local/bin/ssh-askpass-termux
.local/bin/ssh-keygena
.ssh/start_agent.sh
.termux
{{- end }}

{{- if ne .chezmoi.os "linux" }}
.chezmoiscripts/linux/**
{{- end }}


{{- if ne .chezmoi.os "darwin" }}
.chezmoiscripts/darwin/**
Library
{{- end }}

{{- if eq .chezmoi.os "windows" }}
.config/worktrunk
.tmux
{{- end }}

{{- if and (ne .chezmoi.os "darwin") (ne .chezmoi.os "windows") }}
.config/wezterm
{{- end }}

{{- if and (ne .chezmoi.os "linux") (ne .chezmoi.os "darwin") }}
.config/Code
{{- end }}

{{- if and (ne .chezmoi.os "android") (and (ne .chezmoi.os "linux") (ne .chezmoi.os "darwin")) }}
**/*.sh*
.bash*
.blerc
.profile
{{- end }}

{{- if not (get . "sshsigning") }}
# .signingkey is a GPG key id on these hosts, so an allowed_signers built from
# it would be meaningless.
.config/git/allowed_signers
{{- end }}

{{- if ne .hosttype "personal" }}
# Public half of the personal legacy SSH key, deployed so host configs can pin
# it by path (see the private ssh-hosts repo). Not secret, but pointless off
# personal hosts since the agent there never holds the matching private key.
.ssh/legacy.pub
{{- end }}

**/*.cmm
**/*.orig
**/*.src.ini
winget.yaml
