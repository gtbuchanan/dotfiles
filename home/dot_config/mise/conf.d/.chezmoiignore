{{- /* Every fragment is plain TOML so Renovate's mise manager can parse it,
       which is why the platform split has to happen here rather than in
       `{{ if }}` gates inside the files. Fragments deployed everywhere need no
       entry. See docs/mise.md. */}}
{{- if ne .chezmoi.os "android" }}
termux.toml
{{- end }}

{{- /* hass-cli is a personal-host application; work hosts have no use for it. */}}
{{- if ne .hosttype "personal" }}
home-assistant.toml
{{- end }}

{{- /* Windows alone, and the resolver's existence is not the reason — Termux has
       one too. It reaches hass-cli through a wrapper on PATH instead, which
       keeps the token out of every other process mise spawns; `[env]` cannot,
       so it is not deployed where a wrapper serves. Linux and macOS have
       neither yet. See docs/home-assistant.md. */}}
{{- if or (ne .chezmoi.os "windows") (ne .hosttype "personal") }}
home-assistant-credentials.toml
{{- end }}
