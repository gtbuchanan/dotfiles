# Configure GPG_TTY for terminal pinentry
if ([Environment]::UserInteractive -and $Host.UI.RawUI) {
  # The value is arbitrary; the wrapper script only checks if the variable is set
  $env:GPG_TTY = "CON"
}
{{ if and (eq .chezmoi.os "windows") (eq .hosttype "personal") }}
# Serve passwords for hosts that can't do key auth from the Bitwarden vault.
# `force` rather than `prefer`: prefer only consults an askpass when DISPLAY is
# set, which it never is on Windows, so it would silently never fire. force
# therefore routes every prompt through the helper -- including git's, and hosts
# with no vault entry -- which is why the helper always answers, falling back to
# its own dialog rather than failing and aborting the connection.
$sshAskpass = "$HOME\.local\bin\ssh-askpass-bw.cmd"
if (Test-Path $sshAskpass) {
  $env:SSH_ASKPASS = $sshAskpass
  $env:SSH_ASKPASS_REQUIRE = 'force'
}
{{ end }}
# Worktrunk shell integration: subprocesses can't change the parent shell's
# cwd, so `wt config shell init powershell` emits a wrapper function that
# reads directive files written by the binary and runs `cd` in the host
# session. On Windows, `wt` resolves to worktrunk via the `~/.local/bin/wt.exe`
# symlink (Windows Terminal's App Execution Alias for `wt.exe` is removed by
# the winget config). See worktrunk's shell-integration.md.
$wt = Get-Command wt -CommandType Application -ErrorAction SilentlyContinue |
  Select-Object -First 1
if ($wt) {
  # Guarded because a present-but-failing binary yields an empty script, which
  # Invoke-Expression rejects outright rather than treating as a no-op.
  $wtInit = Get-CachedInitScript -Name 'wt' -BinaryPath $wt.Source -Generate {
    & $wt config shell init powershell | Out-String
  }
  if ($wtInit) {
    $wtInit | Invoke-Expression
  }
}

# Enable delta autocomplete (--generate-completion needs delta >= 0.18; skip
# gracefully where an older delta ships, e.g. Ubuntu's 0.16.5)
$delta = Get-Command delta -CommandType Application -ErrorAction SilentlyContinue |
  Select-Object -First 1
if ($delta) {
  # The generator yields an empty string where the flag is unsupported, and
  # that empty result is cached like any other. Keyed on the binary, so a delta
  # new enough to support it re-probes on upgrade rather than every shell.
  $deltaCompletion = Get-CachedInitScript -Name 'delta' -BinaryPath $delta.Source -Generate {
    $out = & $delta --generate-completion powershell 2>$null
    if ($LASTEXITCODE -eq 0) { $out | Out-String } else { '' }
  }
  if ($deltaCompletion) {
    $deltaCompletion | Invoke-Expression
  }
}
