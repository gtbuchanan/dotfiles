{{ if eq .chezmoi.os "android" -}}
# Bitwarden session helpers. These must be functions, not aliases: only the
# calling shell can export BW_SESSION into its own environment. See the
# `bw-session-termux` script for the at-rest wrapping and idle-timeout scheme.
bwl() { bw-session-termux lock; unset BW_SESSION; }
bwu() {
  local key
  key=$(bw-session-termux get) || { unset BW_SESSION; return 1; }
  export BW_SESSION="$key"
}

{{ end -}}
alias c=clear
alias cc=claude
ccc() { clear; claude "$@"; }
# Resumes the conversation this pane was holding, which `--continue` cannot
# pick out once a second pane in the same directory has resumed one. Falls back
# to it where the pane has no record: outside tmux, or after a server restart
# reissued its id.
ccr() {
  local id
  id=$(bash "$HOME/.claude/pane-session" --resolve 2>/dev/null)
  clear
  if [ -n "$id" ]; then
    claude --resume "$id" "$@"
  else
    claude --continue "$@"
  fi
}
alias cm=chezmoi
alias cmcd='cd $(cm source-path)/..'
alias cmm=chezmoi_modify_manager
alias g=git
alias ls='eza --icons=auto'
alias pn=pnpm
