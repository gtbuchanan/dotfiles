{{- /* Resolves the Home Assistant CLI's server and token from the Bitwarden
       vault. One resolver per platform, since the at-rest wrapping is bound to
       a platform API -- DPAPI on Windows, the Android keystore on Termux -- so
       each is its own implementation rather than a port. Personal because
       hass-cli is only deployed there; Linux and macOS have neither yet.

       The Windows pair keeps the `hass-vault` name because mise's [env] names a
       bare command on PATH and the .cmd shim is how a .ps1 becomes one. Termux
       reaches its resolver from the wrappers/ directory instead. */}}
{{- if or (ne .chezmoi.os "windows") (ne .hosttype "personal") }}
hass-vault.cmd
hass-vault.ps1
{{- end }}
{{- if or (ne .chezmoi.os "android") (ne .hosttype "personal") }}
hass-vault
{{- end }}

{{- /* Serves host passwords from the Bitwarden vault via SSH_ASKPASS. Windows
       because that is where the desktop app's biometric IPC lives, personal
       because work hosts use Dashlane and have no password-auth hosts. */}}
{{- if or (ne .chezmoi.os "windows") (ne .hosttype "personal") }}
bw-session-windows.ps1
ssh-askpass-bw.cmd
ssh-askpass-bw.ps1
{{- end }}
