#!/data/data/com.termux/files/usr/bin/sh
# Makes a plain `ssh` do what Termux's `ssha` does: start ssh-agent if none is
# reachable, seed it from the vault through ~/.ssh/start_agent.sh, and export
# SSH_AUTH_SOCK, before running ssh.
#
# Termux leaves that to the separate `ssha` name, so a bare `ssh` from an
# agent session, a script or rsync finds no agent and falls back to keys that
# are not on disk. A shell alias reaches only interactive shells; this file
# shadows ssh for every caller, because PATH puts ~/.local/bin/wrappers ahead
# of $PREFIX/bin.
#
# It runs ssh by its prefix path. Termux's own wrappers run "$wrapped_cmd",
# which source-ssh-agent.sh derives from $0 by dropping a trailing `a`; named
# `ssh`, that resolves back to this file and loops. `ssha` still works: it
# resolves `ssh` to this file, which checks the agent again with a quick
# `ssh-add -L` and runs the real binary.
#
# A cold start prompts for a fingerprint on any ssh, `ssh -V` included, as
# `ssha` always has. The agent script writes nothing to stdout, which matters
# because Git's ssh transport owns it.
#
# This is run by sh, so it must stay POSIX -- no bashisms.

prefix=${TERMUX__PREFIX:-$PREFIX}

# Termux ships this script outside the repo, so there is nothing to follow.
# shellcheck source=/dev/null
. "$prefix/libexec/source-ssh-agent.sh"

exec "$prefix/bin/ssh" "$@"
