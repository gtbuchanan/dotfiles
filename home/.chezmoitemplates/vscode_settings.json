{{- $json := dict -}}
{{- if ne .chezmoi.stdin "" -}}
{{- $json = fromJson .chezmoi.stdin -}}
{{- end -}}
{
  "[git-commit]": {
    "editor.rulers": [
      72
    ]
  },
  "[sql]": {
    "editor.defaultFormatter": "dorzey.vscode-sqlfluff"
  },
  "[vue]": {
    "editor.defaultFormatter": "Vue.volar"
  },
  "editor.fontFamily": "'{{ .font }}', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.renderWhitespace": "all",
  "editor.rulers": [
    {
      "column": 100,
      "color": "#ff000040"
    }
  ],
  "editor.wordWrap": "on",
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "githubPullRequests.pullBranch": "never",
  "markdown-preview-enhanced.previewTheme": "github-dark.css",
{{- range $key := list "mssql.connections" "mssql.connectionGroups" }}
  "{{ $key }}":
{{- get $json $key | default list | toPrettyJson | indent 1 | trim | comment " " }},
{{- end }}
  "mssql.enableRichExperiences": true,
{{- /* Todo Tree 0.0.226 searches appRoot for vscode-ripgrep and
       @vscode/ripgrep only, and VS Code ships @vscode/ripgrep-universal now,
       so the extension fails to start until this setting names an rg. Its
       bundled copy lives under a directory named for the installed build, so
       an upgrade would break the path; mise's shim outlives one. */}}
  "todo-tree.ripgrep.ripgrep":
{{- if eq .chezmoi.os "windows" }} "{{ .chezmoi.homeDir }}/AppData/Local/mise/shims/rg.exe",
{{- else }} "{{ .chezmoi.homeDir }}/.local/share/mise/shims/rg",
{{- end }}
  "workbench.colorTheme": "Default Dark+",
  "workbench.startupEditor": "none"
}
