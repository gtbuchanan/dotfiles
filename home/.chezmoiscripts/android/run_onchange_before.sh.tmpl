#!/data/data/com.termux/files/usr/bin/bash
# Base Termux packages. Claude Code's glibc deps (glibc-repo, glibc-runner,
# patchelf-glibc) and toolchain are owned by the claude-code-termux package,
# installed by run_onchange_after_claude-code-install.sh.tmpl.
#
# shellcheck/shfmt/ruff and clang (for clang-format) back the hk lint hooks:
# mise can't install them on android, so they come from pkg as native bionic
# builds and hk resolves them from PATH (see dot_config/mise/conf.d/termux.toml).
# chezmoi is here too: the aqua build installs but can't resolve DNS on bionic,
# so the pkg build is the working one (same file — see termux.toml disable_tools).
#
# age/sops are the same story as the lint tools — no android asset upstream,
# native bionic builds in pkg — but they back SOPS-encrypted secrets rather
# than a lint hook, and a repo pinning them fails `mise x` for every hook step
# until they resolve from PATH.
#
# uv likewise: aqua ships no android asset, so the pkg build serves from PATH as
# the engine mise's pipx backend installs `pipx:` tools with.
PKG_PACKAGES=(
  "age"
  "bash-completion"
  "chezmoi"
  "clang"
  "eza"
  "fzf"
  "gh"
  "git-delta"
  "gnupg"
  "jq"
  "mise"
  "ncurses-utils"
  "nodejs-lts"
  "openssh"
  "ripgrep"
  "ruff"
  "shellcheck"
  "shfmt"
  "sops"
  "starship"
  "termux-api"
  "termux-services"
  "tmux"
  "tudo"
  "turbo"
  "uv"
  "vim"
)
pkg update
pkg install -y $(printf "%s " "${PKG_PACKAGES[@]}")

# Install ble.sh
curl -L https://github.com/akinomyoga/ble.sh/releases/download/nightly/ble-nightly.tar.xz | tar -xJf - -C "$TMPDIR"
bash "$TMPDIR/ble-nightly/ble.sh" --install "$HOME/.local/share"
rm -Rf "$TMPDIR/ble-nightly"

# Install pnpm
npm i -g pnpm
