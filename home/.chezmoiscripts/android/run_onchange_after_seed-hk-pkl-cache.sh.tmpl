#!/data/data/com.termux/files/usr/bin/bash
{{/*
  Seeds pklr's package cache for this repo's hk.pkl on Termux/Android, by
  running ~/.local/bin/hk-seed-pkl-cache on the working tree. That script
  explains why hk needs it; other repos run it by hand.

  The import list below is rendered from hk.pkl so that bumping hk or
  hk-config there re-fires this script without a second copy of either
  version here. The working tree is read from CHEZMOI_WORKING_TREE at run
  time rather than rendered, to keep the hash independent of --source (see
  AGENTS.md). chezmoi runs `after` scripts once files are applied, so the
  seeder is already deployed.
*/}}
set -euo pipefail

# hk.pkl imports (the run_onchange trigger):
{{- range regexFindAll "package://[^\"]+" (include "../hk.pkl") -1 }}
#   {{ . }}
{{- end }}

exec "$HOME/.local/bin/hk-seed-pkl-cache" "${CHEZMOI_WORKING_TREE:?CHEZMOI_WORKING_TREE is unset}"
