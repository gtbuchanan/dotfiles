#!/usr/bin/env bash
#
# PreToolUse guard for commands an agent session must not run:
#
#   - anything that prints a vault secret onto stdout, where it becomes a
#     permanent part of the transcript;
#   - anything that ends PowerShell processes by name, which reaches every pwsh
#     on the machine rather than the one that was meant.
#
# One hook rather than one per concern, and the reason is complexity rather than
# speed: matching hooks run in PARALLEL, so a second hook costs a whole
# interpreter startup but adds nothing to the wall clock. What it does add is a
# second copy of the matching below -- and the PowerShell guard this absorbed
# had exactly that, a substring match that refused `cat` of its own source and
# refused a commit message naming the file. Here a new rule is a few lines in
# the table, sharing one parser that has tests.
#
# The rule this enforces was prose in AGENTS.md and nothing else. Prose is the
# wrong medium for it: `hass-vault credential` is the documented way for the
# hass-cli wrapper to fetch the token, so an agent reasoning from first
# principles will find it, and an instruction not to run it competes with
# everything else in context. This decides before the process starts, which is
# the only point at which the outcome is still recoverable -- a token that has
# reached stdout has been logged, and the answer to that is rotating it, not
# deleting a message.
#
# Bash rather than PowerShell, unlike the sibling deny-pwsh-kill.ps1, because
# the commands guarded here ship on Windows AND on Termux, and Termux has no
# pwsh. Git Bash covers the Windows side, so one implementation and one shUnit2
# suite serve both -- and test:shunit2 already runs on every CI leg, where a
# Pester suite would only run on the Windows one.
#
# WHAT THIS DOES NOT DO. It sees the command the agent asked to run, never the
# processes that command spawns. `hass-cli` resolves the same token internally
# and is deliberately untouched: the point is to route the agent to the wrapper,
# not to stop it working. Nor is this a sandbox -- a determined caller can
# obfuscate past any string matcher. It is a guardrail against the accident,
# which is the way this actually goes wrong.
#
# Emits a PreToolUse `deny` decision on match; stays silent (exit 0) otherwise
# so normal permission handling continues. See test/deny_vault_secrets_test.sh.

# Pathname expansion is off for the whole script: the only word splitting done
# here is over an untrusted command string, and a stray `*` in it must stay a
# literal rather than become whatever happens to sit in the working directory.
set -f

# `read -d ''` rather than the obvious `$(cat)`, which is a subshell and an exec
# for a value that is already on stdin -- together the single largest cost in
# this script, on a Windows fork. Reading to a NUL that a JSON payload does not
# contain consumes the whole stream and returns non-zero at EOF, which is the
# success case here; and unlike a command substitution it preserves a trailing
# newline rather than stripping it.
IFS= read -r -d '' payload
[ -n "$payload" ] || exit 0

# --- what is refused, and what is deliberately left alone -------------------
#
# Each family is an allowlist of its non-emitting subcommands rather than a
# denylist of the emitting ones, so a subcommand added upstream is refused until
# someone has looked at it. The bare invocation matters as much as the named
# one: `hass-vault` and `bw-session-*` both default to the subcommand that
# prints the secret, so an empty subcommand has to fall through to the deny.
#
# `bw` is the exception and is a denylist. An allowlist there would refuse
# `bw edit`, `bw create`, `bw generate` and the rest for no secrecy gain -- none
# of them put vault contents on stdout -- and friction with no payoff is what
# teaches an agent to route around a guard rather than respect it.

HASS_VAULT_SAFE=' check status refresh reset '
BW_SESSION_SAFE=' check lock reset status '
BW_EMITS=' get list export unlock login serve '

# Interpreters whose arguments are themselves a command. Without this,
# `pwsh -c hass-vault` would read as an invocation of pwsh and nothing more. The
# quoted form (`pwsh -c "hass-vault"`) is already split apart by the separator
# pass below; this covers the unquoted single-word case.
SHELLS=' bash sh dash zsh ksh pwsh powershell cmd '

reason=''

# --- helpers -----------------------------------------------------------------
#
# These return through named globals rather than through command substitution.
# `$(...)` forks, this hook runs before every Bash and PowerShell call in the
# session, and these run once per segment and per token -- so on Windows, where
# a fork costs milliseconds rather than microseconds, returning the readable way
# made the test suite take minutes.
#
# That reasoning stops at the payload extraction below, which does run a
# pipeline. It was hand-rolled here too, and that was a mistake worth recording:
# matching hooks run in PARALLEL, so this script's cost is not added to the
# other guards' but hidden behind whichever is slowest -- and the PowerShell
# guard beside it spends ~1550ms on interpreter startup alone against ~270ms
# here. The 40 lines of quote-scanning that saved ~120ms bought nothing
# measurable and cost the most intricate code in the file, so it went back to a
# pipeline. Optimize the interpreter count, not the parser.

# True when $2 appears in the space-delimited set $1. The surrounding spaces are
# load-bearing: they make this a whole-token test, so `bw` never matches inside
# `bwbio`, and `list` never matches inside `listen`.
in_set() {
  case $1 in *" $2 "*) return 0 ;; esac
  return 1
}

# Enough JSON unescaping to matter for matching: a quote ends a shell word and a
# newline separates commands, so both change where a command position falls.
# Deliberately not a JSON parser -- \uXXXX and the \\n-versus-\n distinction are
# left alone, because neither can turn a refused command into an allowed one.
unescape() { # $1 = raw JSON string body -> _text
  _text=${1//\\n/$'\n'}
  _text=${_text//\\t/	}
  _text=${_text//\\r/}
  _text=${_text//\\\"/\"}
  _text=${_text//\\\\/\\}
}

# The whole design in one function: cut the command at every character that can
# end one, so each fragment begins where a command name would. Matching in
# command position -- rather than anywhere in the string, as deny-pwsh-kill.ps1
# does -- is what keeps `cat .../hass-vault.ps1` and `grep credential ...`
# runnable while still catching `foo && hass-vault`.
#
# Quotes are cut on too, which is how `pwsh -c "hass-vault credential"` is
# reached. The cost is that prose inside a quoted argument reads as a command,
# so `echo "hass-vault credential is forbidden"` denies. That is the direction
# to be wrong in: a refused echo is recoverable and a leaked token is not.
split_into_segments() { # $1 = command text -> _segments
  local s=$1 c
  for c in ';' '&' '|' '(' ')' '{' '}' '`' '"' "'" '<' '>' $'\n' $'\r'; do
    s=${s//"$c"/$'\v'}
  done
  local IFS=$'\v'
  # Splitting on the sentinel is the point here, and pathname expansion is off
  # (set -f, at the top), so the unquoted expansion is deliberate.
  # shellcheck disable=SC2206
  _segments=($s)
}

# The name a command would actually resolve to: the last path component, with a
# Windows launcher extension dropped so hass-vault, hass-vault.ps1 and
# hass-vault.cmd are one thing rather than three.
#
# Lowercased, because PowerShell resolves command names case-insensitively --
# `STOP-PROCESS` runs exactly as `Stop-Process` does, so a case-sensitive table
# would be a table with a one-keystroke bypass.
basename_of() { # $1 = token -> _binary
  _binary=${1##*/}
  _binary=${_binary##*\\}
  _binary=${_binary,,}
  case $_binary in
  *.ps1) _binary=${_binary%.ps1} ;;
  *.cmd) _binary=${_binary%.cmd} ;;
  *.exe) _binary=${_binary%.exe} ;;
  *.bat) _binary=${_binary%.bat} ;;
  *.sh) _binary=${_binary%.sh} ;;
  esac
}

# --- the decision table ------------------------------------------------------

# Whether the command names a PowerShell process at all, anywhere in its text
# rather than in command position.
#
# Deliberately not command-position: in `Stop-Process -Name pwsh` the process is
# an argument, and in `Get-Process pwsh | Stop-Process` it is in a different
# segment entirely. This is what separates the kill that takes down every pwsh
# on the machine -- other agent sessions, the user's terminals, the harness's
# own shell host -- from `Stop-Process -Id 4321`, which reaps one process the
# caller started and stays allowed.
targets_powershell() {
  case $command_lower in *pwsh* | *powershell*) return 0 ;; esac
  return 1
}

# Terminating forms that never put their verb in command position, so the
# segment walk cannot reach them. `.Kill(` is distinctive enough to match
# anywhere; `Terminate` is an ordinary English word, so it is only believed when
# an invoker that actually takes a method name is being run.
verdict_whole_command() {
  targets_powershell || return 1
  local hit=1
  case $command_lower in *'.kill('* | *'.kill ('*) hit=0 ;; esac
  if [ $hit -eq 1 ] && [ -n "$cim_invoked" ]; then
    case $command_lower in *terminate*) hit=0 ;; esac
  fi
  [ $hit -eq 0 ] || return 1
  reason=$TERMINATION_REASON
  return 0
}

TERMINATION_REASON='Blocked: this ends PowerShell processes by name rather than
    by pid, which reaches every matching process on the machine -- the pwsh
    hosts of other agent sessions, terminals the user has open, and the
    harness own shell host -- not only the one you meant. To reap something
    you started, find its pid (from the job you launched, or by filtering
    Get-CimInstance Win32_Process on the command line) and target that:
    Stop-Process -Id <pid>, or taskkill /PID <pid>.'

# Sets $reason and returns 0 when this binary/subcommand pair emits a secret.
verdict() { # $1 = binary, $2 = subcommand
  case $1 in
  stop-process | spps | kill | taskkill | pkill | killall)
    # The verb alone is not the offence -- reaping a pid is fine -- so this
    # turns on whether a PowerShell process is named anywhere in the command.
    targets_powershell || return 1
    reason=$TERMINATION_REASON
    return 0
    ;;
  invoke-cimmethod | invoke-wmimethod)
    # Noted for verdict_whole_command, which decides once it can see whether
    # Terminate is the method being invoked.
    cim_invoked=1
    return 1
    ;;
  hass-vault)
    in_set "$HASS_VAULT_SAFE" "$2" && return 1
    reason='Blocked: this prints the Home Assistant long-lived token in full,
        putting a credential into the transcript permanently. It exists for the
        hass-cli wrapper to read, not for a human or an agent. Run hass-cli
        directly -- the wrapper supplies the credential inside its own process
        -- or diagnose with hass-vault check (do credentials resolve) and
        hass-vault status (is anything cached), neither of which emits a value.
        Note that a bare hass-vault is the credential subcommand: it is the
        default.'
    return 0
    ;;
  bw-session-windows | bw-session-termux)
    in_set "$BW_SESSION_SAFE" "$2" && return 1
    reason='Blocked: this prints the Bitwarden session key, which decrypts the
        whole vault and would persist in the transcript. A bare invocation is
        the get subcommand: it is the default. Use check for whether the cache
        is warm, or status for how long it has left; neither emits a value.'
    return 0
    ;;
  bwbio)
    reason='Blocked: this performs a biometric unlock and prints the resulting
        Bitwarden session key, which decrypts the whole vault and would persist
        in the transcript. It exists for bw-session-windows.ps1 to read; use
        that script status subcommand to inspect the cache instead.'
    return 0
    ;;
  ssh-askpass-bw | ssh-askpass-termux)
    reason='Blocked: this is an SSH_ASKPASS helper. It writes a passphrase to
        stdout, which is how ssh reads one, so running it by hand puts that
        passphrase into the transcript. It is meant to be invoked by ssh, never
        directly.'
    return 0
    ;;
  bw)
    in_set "$BW_EMITS" "$2" || return 1
    reason='Blocked: this bw subcommand writes vault contents to stdout -- an
        item password, item JSON carrying custom fields, a full export, or a
        session key -- which would persist in the transcript. bw status, sync
        and lock are unaffected. If a secret genuinely has to be read, ask the
        user to read it out of band rather than through this session.'
    return 0
    ;;
  esac
  return 1
}

# Walks one fragment to the command it starts with, then to that command's first
# non-flag argument, and asks for a verdict on the pair.
#
# The leading skips are the forms that put something before the command without
# being one: an environment assignment (the documented way to reach another Home
# Assistant instance, so the form most likely to be typed), and the wrappers
# that take a command as their argument.
evaluate() { # $1 = fragment, $2 = interpreter recursion depth
  local depth=${2:-0}
  [ "$depth" -gt 3 ] && return 1

  # Splitting the fragment into shell words is the point here, and pathname
  # expansion is off (set -f, at the top), so the unquoted expansion is
  # deliberate.
  # shellcheck disable=SC2086
  set -- $1
  while [ $# -gt 0 ]; do
    case $1 in
    *=*) shift ;;
    sudo | exec | command | env | nohup | time | builtin) shift ;;
    *) break ;;
    esac
  done
  [ $# -gt 0 ] || return 1

  basename_of "$1"
  local binary=$_binary
  shift

  # An interpreter's arguments are a command in their own right, so re-enter on
  # what follows its flags rather than stopping at the interpreter itself.
  if in_set "$SHELLS" "$binary"; then
    while [ $# -gt 0 ]; do
      case $1 in
      -*) shift ;;
      *) break ;;
      esac
    done
    [ $# -gt 0 ] || return 1
    evaluate "$*" $((depth + 1))
    return $?
  fi

  # The subcommand is the first argument that is not a flag, which also reads
  # the PowerShell named-parameter form (-Command credential) correctly.
  local subcommand=''
  while [ $# -gt 0 ]; do
    case $1 in
    -*) shift ;;
    *)
      subcommand=$1
      break
      ;;
    esac
  done

  verdict "$binary" "$subcommand"
}

# --- payload -----------------------------------------------------------------

# Every "command" string in the payload, not just the first. A single greedy
# match could be walked off the real command by any other field that happened to
# carry the same key, so each candidate is evaluated and any one of them denying
# is enough. `description` is untouched by design: it is model-authored prose
# that ships with every Bash call and is never executed, so letting it decide
# would deny on a command merely being talked about.
#
# The alternation matches an escaped anything or a non-quote, so the string ends
# at the first *unescaped* quote, as JSON requires.

# --- decide ------------------------------------------------------------------

denied=1
while IFS= read -r raw; do
  [ -n "$raw" ] || continue
  unescape "$raw"
  # Lowercased once per command for the whole-command tests, which are
  # case-insensitive for the same reason the binary table is.
  command_lower=${_text,,}
  cim_invoked=''
  split_into_segments "$_text"
  for segment in ${_segments[@]+"${_segments[@]}"}; do
    [ -n "${segment// /}" ] || continue
    if evaluate "$segment"; then
      denied=0
      break
    fi
  done
  # After the segments, because it needs what they found -- whether a method
  # invoker was among the commands being run.
  if [ "$denied" -ne 0 ] && verdict_whole_command; then
    denied=0
  fi
  [ "$denied" -eq 0 ] && break
done < <(
  printf '%s' "$payload" |
    grep -oE '"command"[[:space:]]*:[[:space:]]*"(\\.|[^"\\])*"' |
    sed -E 's/^"command"[[:space:]]*:[[:space:]]*"//; s/"$//'
)

[ "$denied" -eq 0 ] || exit 0

# Collapse the reason's source formatting -- newlines and indentation -- into
# single spaces. It is a JSON string read as a sentence, and keeping the
# messages above wrapped is what makes them readable in the source.
reason=${reason//$'\n'/ }
while [[ $reason == *"  "* ]]; do reason=${reason//  / }; done
reason=${reason# }
reason=${reason% }

# Hand-built rather than piped through jq, and the payload is read with grep and
# sed for the same reason: a hook that dies because jq is missing exits
# non-zero, which reads as a broken hook rather than as a refusal -- so the
# command runs, and the guard has silently stopped existing. grep and sed are
# present wherever this runs at all; jq is a package that may not be. The
# reasons above are the only interpolated text, and none contains a quote or
# backslash to escape.
printf '{"hookSpecificOutput": {"hookEventName": "PreToolUse", '
printf '"permissionDecision": "deny", "permissionDecisionReason": "%s"}}\n' "$reason"

exit 0
