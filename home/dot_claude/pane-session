#!/usr/bin/env bash
#
# SessionStart hook pairing a multiplexer pane with the Claude session started
# in it, so a pane can resume its own conversation rather than the newest one.
#
# `claude --continue` resolves the most recent transcript for the working
# directory: ~/.claude/projects/<slugified-cwd>/ holds one .jsonl per session
# and records nothing about which pane produced it. Two panes in one repo
# therefore resume the same conversation, and whichever resumes first becomes
# the "most recent" that the other then picks up. SessionStart calls --record
# to write the pane's session id here, --resolve reads it back for `ccr`, and
# SessionEnd calls --forget to delete it once that session ends -- so a closed
# pane leaves nothing for an unrelated later one to inherit.
#
# --forget only deletes a record that still names the session it was told
# ended: a pane can start a second session before the first one's SessionEnd
# hook runs, and the record by then belongs to that newer session.
#
# tmux and psmux both export TMUX_PANE into the pane and child processes
# inherit it, so the pane id arrives in the environment on every platform.
# notify-input.ps1 instead walks the process tree to a `#{pane_pid}`; it
# predates this and can be simplified to match.
#
# A server hands out pane ids from %0 on each start, so a record outlives the
# pane it describes and that id can later belong to an unrelated pane. Each
# record stores the pane's directory and --resolve rejects one that no longer
# matches, which costs a stale pane a fallback to `--continue` rather than
# resuming a conversation from somewhere else.
#
# Every failure is silent and exits 0: a SessionStart hook that fails surfaces
# as an error on a session that is otherwise fine, and the cost of recording
# nothing is that `ccr` falls back to `--continue`.
#
# A record therefore names its directory in whatever spelling jq received. On
# Windows that is the native path, because jq is a native binary and MSYS
# rewrites path-shaped values on the way in: /tmp/x and /c/Users/.../Temp/x
# both arrive as C:/Users/.../Temp/x. Both modes cross that same boundary, so a
# pane still matches its own record whichever spelling its shell reports, and
# the comparison is stricter off Windows only in that nothing normalizes it.
#
# --forget only reaches a record when Claude Code itself runs SessionEnd for
# the session that owns it, which a crash, a `kill -9`, or a power loss skips
# outright. --record therefore prunes anything past the retention window on
# every call, so an unreaped record is bounded in age rather than permanent.
#
# A successful --record or --forget also fires psmux-snapshot (~/.psmux,
# alongside psmux's other files, not here) in the background, so
# psmux-restore has a fresh copy of the whole layout to work from after a
# reboot -- see that script for what it captures and why. This script stays
# deliberately ignorant of psmux itself: it only knows that script exists and
# where the per-pane records it reads live.

mode=''
root="$HOME/.claude/panes"
readonly max_age_seconds=$((30 * 24 * 60 * 60))

# psmux-snapshot lives under ~/.psmux, not alongside this script -- it is a
# psmux concern, not a Claude one, so it deploys with the rest of psmux's own
# files rather than Claude's. Overridable so tests can substitute a stub
# without psmux-snapshot's own dependencies (a real or fake psmux) ever
# entering this script's tests.
snapshot_bin="${PANE_SESSION_SNAPSHOT_BIN:-$HOME/.psmux/psmux-snapshot}"

# Deletes every record older than max_age_seconds. A corrupt or pre-pruning
# record with no recordedEpoch field reads back as 0 -- older than anything --
# so it is swept too rather than kept around indefinitely by a missing field.
prune_stale() {
  [ -d "$root" ] || return 0

  local threshold f age
  threshold=$(($(date +%s) - max_age_seconds))
  for f in "$root"/*.json; do
    [ -e "$f" ] || continue
    age=$(jq -r '.recordedEpoch // 0' "$f" 2>/dev/null)
    case "$age" in '' | *[!0-9]*) age=0 ;; esac
    [ "$age" -lt "$threshold" ] && rm -f "$f" 2>/dev/null
  done
}

# Backgrounded so a slow or missing psmux-snapshot never delays the
# SessionStart/SessionEnd hook this script is actually running as.
trigger_snapshot() {
  "$snapshot_bin" --root "$root" >/dev/null 2>&1 &
}

while [ $# -gt 0 ]; do
  case "$1" in
  --record) mode='record' ;;
  --resolve) mode='resolve' ;;
  --forget) mode='forget' ;;
  --root)
    [ $# -ge 2 ] || exit 0
    root="$2"
    shift
    ;;
  *) exit 0 ;;
  esac
  shift
done

[ -n "$mode" ] || exit 0

pane="${TMUX_PANE:-}"
[ -n "$pane" ] || exit 0

# $TMUX is <socket>,<server pid>,<session id>. The socket's leaf is what
# separates one server from another -- `-L other` puts `other` there -- while
# the pid in its parent directory changes on every start, so keying on the leaf
# survives a restart and keying on the whole path would not.
namespace='default'
if [ -n "${TMUX:-}" ]; then
  socket="${TMUX%%,*}"
  namespace="${socket##*/}"
fi

# Pane ids carry a '%' and session names are free text, so both are reduced to
# what a filename can hold.
key=$(printf '%s-%s' "$namespace" "$pane" | tr -c 'A-Za-z0-9._-' '_')
record="$root/$key.json"

if [ "$mode" = 'record' ]; then
  prune_stale

  payload=$(cat)
  [ -n "$payload" ] || exit 0

  session_id=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)
  [ -n "$session_id" ] || exit 0

  mkdir -p "$root" || exit 0

  # Written aside and moved so a concurrent --resolve reads either the previous
  # record or this one, never half of one.
  staging="$record.$$"
  cwd="$PWD" namespace="$namespace" paneId="$pane" sessionId="$session_id" \
    recorded="$(date -u +%Y-%m-%dT%H:%M:%SZ)" recordedEpoch="$(date +%s)" \
    jq -n '{
      cwd: $ENV.cwd,
      namespace: $ENV.namespace,
      paneId: $ENV.paneId,
      recorded: $ENV.recorded,
      recordedEpoch: ($ENV.recordedEpoch | tonumber),
      sessionId: $ENV.sessionId
    }' >"$staging" 2>/dev/null &&
    mv -f "$staging" "$record" 2>/dev/null
  rm -f "$staging" 2>/dev/null

  trigger_snapshot
  exit 0
fi

if [ "$mode" = 'forget' ]; then
  payload=$(cat)
  [ -n "$payload" ] || exit 0

  session_id=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)
  [ -n "$session_id" ] || exit 0

  [ -f "$record" ] || exit 0
  recorded_session=$(jq -r '.sessionId // empty' "$record" 2>/dev/null)
  [ "$recorded_session" = "$session_id" ] || exit 0

  rm -f "$record" 2>/dev/null

  trigger_snapshot
  exit 0
fi

[ -f "$record" ] || exit 0
cwd="$PWD" jq -r 'select(.cwd == $ENV.cwd) | .sessionId // empty' \
  "$record" 2>/dev/null
exit 0
