#!/usr/bin/env bash

# --cost adds a session-spend segment. A flag rather than something the script
# works out for itself, because what decides it is the host's billing: under
# usage-based billing the figure is money, and under a subscription it is a
# notional API-equivalent price that would read as spend that never happens.
# That is a hosttype question, and settings.json.tmpl is where chezmoi can
# answer it -- which is what keeps this script a plain file rather than a
# template, and directly testable. See test/claude_statusline_test.sh.
SHOW_COST=0
for arg in "$@"; do
  [ "$arg" = "--cost" ] && SHOW_COST=1
done

# Claude Code runs this on every update of every open session, so what it
# costs is paid many times a minute. On Windows under endpoint protection
# every new process costs up to a second, and a render that started a few
# dozen -- a jq per field, a subshell per glyph, a git per count -- ran long
# enough for the next one to start behind it, until the backlog stalled the
# machine. So everything that can be a builtin is one: `read` for stdin and
# files, `printf -v` for glyphs, parameter expansion for the cache key. What
# is left is one jq for the payload, and on a cache miss two calls to git.
IFS= read -r -d '' input

# Every field the bar needs, from one jq. Joined on the unit separator rather
# than a tab: a tab is whitespace to `read`, which would collapse an empty
# field and shift every field after it.
US=$'\x1f'
fields=$(jq -r '[
    (.model.display_name | tostring),
    (try (((.worktree.original_cwd // .workspace.project_dir)
      | gsub("\\\\"; "/") | split("/") | map(select(length > 0))) as $parts
      | ($parts | map(select(endswith(".worktrees"))) | first) as $wt
      | if $wt then ($wt | rtrimstr(".worktrees")) else ($parts | last) end)
      catch ""),
    ((.context_window.used_percentage // 0) | tostring | split(".")[0]),
    (.worktree.name // ""),
    (.cwd | tostring),
    ((.cost.total_cost_usd // 0) | tostring)
  ] | map(. // "") | join("\u001f")' <<<"$input")
IFS="$US" read -r MODEL DIR PCT WORKTREE_NAME CWD COST <<<"$fields"

# Palette matching starship config
ENV_BG='\033[48;2;58;58;58m'
DIR_BG='\033[46m'
GIT_BG='\033[48;2;111;66;193m'
CTX_BG_GREEN='\033[42m'
CTX_BG_YELLOW='\033[43m'
CTX_BG_RED='\033[41m'
LIGHT_FG='\033[97m'
DARK_FG='\033[30m'

WT_BG='\033[48;2;249;108;42m'

ENV_FG='\033[38;2;58;58;58m'
DIR_FG='\033[36m'
WT_FG='\033[38;2;249;108;42m'
GIT_FG='\033[38;2;111;66;193m'
CTX_FG_GREEN='\033[32m'
CTX_FG_YELLOW='\033[33m'
CTX_FG_RED='\033[31m'

RESET='\033[0m'

# Nerd font glyphs (printf to get actual UTF-8 bytes; -v so no subshell)
printf -v SEP '\xee\x82\xb0'            #  powerline right arrow
printf -v SEP_ROUND_L '\xee\x82\xb6'    #  powerline left round
printf -v SEP_ROUND_R '\xee\x82\xb4'    #  powerline right round
printf -v ICON_DIR '\xef\x90\x88'       #  nf-oct-file_directory_fill
printf -v ICON_BRANCH '\xef\x90\x98'    #  nf-oct-git_branch
printf -v ICON_STAGED '\xef\x81\x86'    #  nf-fa-check_square_o
printf -v ICON_MODIFIED '\xef\x81\x84'  #  nf-fa-pencil_square_o
printf -v ICON_ROBOT '\xf3\xb0\x9a\xa9' # 9 nf-md-robot
printf -v ICON_REBASE '\xee\x9c\xa8'    #  nf-dev-git_merge
printf -v ICON_MERGE '\xee\x9c\xa7'     #  nf-dev-git_compare
printf -v ICON_REVERT '\xef\x83\xa2'    #  nf-fa-undo
printf -v ICON_CHERRY '\xee\x8a\x9b'    #  nf-oct-ruby
printf -v ICON_STASH '\xef\x83\x87'     #  nf-fa-floppy_o

# --- Model segment (env_bg) ---
LINE="${ENV_FG}${SEP_ROUND_L}${RESET}${ENV_BG}${LIGHT_FG} ${ICON_ROBOT} ${MODEL} ${RESET}"
PREV_BG_FG="${ENV_FG}"

# --- Directory segment (dir_bg) ---
LINE="${LINE}${DIR_BG}${PREV_BG_FG}${SEP}${RESET}${DIR_BG}${DARK_FG} ${ICON_DIR} ${DIR} ${RESET}"
PREV_BG_FG="${DIR_FG}"

# --- Git segment (git_bg) ---
# Keyed by the cwd, escaped reversibly rather than hashed: `_` doubles first,
# so the escapes that follow it cannot collide with a name that already held
# one, and no hash tool has to be started to name the file.
CACHE_KEY="${CWD//_/__}"
CACHE_KEY="${CACHE_KEY//\//_s}"
CACHE_KEY="${CACHE_KEY//\\/_b}"
CACHE_KEY="${CACHE_KEY//:/_c}"
CACHE_BASE="${TMPDIR:-/tmp}"
CACHE_FILE="${CACHE_BASE}/claude-statusline-git-${CACHE_KEY}"
CACHE_MAX_AGE=5

# The cache records when it was written as its first field, so its age needs
# no `stat`. $EPOCHSECONDS is bash 5; `date` covers the bash 3.2 macOS ships.
NOW="${EPOCHSECONDS:-$(date +%s)}"
CACHED_AT=''
[ -f "$CACHE_FILE" ] &&
  IFS='|' read -r CACHED_AT BRANCH STAGED MODIFIED UNTRACKED AHEAD BEHIND \
    STATE STEP TOTAL STASH IS_WORKTREE <"$CACHE_FILE"
case "$CACHED_AT" in '' | *[!0-9]*) CACHED_AT=0 ;; esac

if [ $((NOW - CACHED_AT)) -gt $CACHE_MAX_AGE ]; then
  BRANCH='' STAGED=0 MODIFIED=0 UNTRACKED=0 AHEAD=0 BEHIND=0
  STATE='' STEP='' TOTAL='' STASH=0 IS_WORKTREE=''
  if GIT_PATHS=$(git rev-parse --git-dir --git-common-dir 2>/dev/null); then
    GIT_DIR="${GIT_PATHS%%$'\n'*}"
    GIT_COMMON_DIR="${GIT_PATHS#*$'\n'}"
    # Linked worktree: per-worktree gitdir differs from the common gitdir.
    IS_WORKTREE=0
    [ "$GIT_DIR" != "$GIT_COMMON_DIR" ] && IS_WORKTREE=1
    # Detect rebase/merge/cherry-pick/revert state
    if [ -d "${GIT_DIR}/rebase-merge" ]; then
      read -r STEP 2>/dev/null <"${GIT_DIR}/rebase-merge/msgnum"
      read -r TOTAL 2>/dev/null <"${GIT_DIR}/rebase-merge/end"
      STATE="$ICON_REBASE"
    elif [ -d "${GIT_DIR}/rebase-apply" ]; then
      read -r STEP 2>/dev/null <"${GIT_DIR}/rebase-apply/next"
      read -r TOTAL 2>/dev/null <"${GIT_DIR}/rebase-apply/last"
      STATE="$ICON_REBASE"
    elif [ -f "${GIT_DIR}/MERGE_HEAD" ]; then
      STATE="$ICON_MERGE"
    elif [ -f "${GIT_DIR}/CHERRY_PICK_HEAD" ]; then
      STATE="$ICON_CHERRY"
    elif [ -f "${GIT_DIR}/REVERT_HEAD" ]; then
      STATE="$ICON_REVERT"
    fi

    # One status call answers what used to take a git per count: the branch,
    # ahead/behind, the stash, and every changed path. Untracked files are
    # listed individually, as `ls-files --others` did, rather than collapsed
    # to their directory. --no-optional-locks because this runs unbidden
    # beside whatever git the user is running, and must not take the index
    # lock from it.
    STATUS=$(git --no-optional-locks status --porcelain=v2 --branch \
      --show-stash --untracked-files=all 2>/dev/null)
    while IFS= read -r ENTRY; do
      case "$ENTRY" in
      '# branch.head '*) BRANCH="${ENTRY#'# branch.head '}" ;;
      '# branch.ab '*)
        AB="${ENTRY#'# branch.ab +'}"
        AHEAD="${AB%% *}"
        BEHIND="${AB##* -}"
        ;;
      '# stash '*) STASH="${ENTRY#'# stash '}" ;;
      # Changed paths carry XY: X is the index against HEAD, Y the working
      # tree against the index, and "." means unchanged.
      '1 '* | '2 '*)
        [ "${ENTRY:2:1}" != '.' ] && STAGED=$((STAGED + 1))
        [ "${ENTRY:3:1}" != '.' ] && MODIFIED=$((MODIFIED + 1))
        ;;
      'u '*)
        STAGED=$((STAGED + 1))
        MODIFIED=$((MODIFIED + 1))
        ;;
      '? '*) UNTRACKED=$((UNTRACKED + 1)) ;;
      esac
    done <<<"$STATUS"
    # Fallback to detached HEAD
    [ -z "$BRANCH" ] || [ "$BRANCH" = '(detached)' ] && BRANCH="HEAD"
  fi
  printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' "$NOW" "$BRANCH" "$STAGED" \
    "$MODIFIED" "$UNTRACKED" "$AHEAD" "$BEHIND" "$STATE" "$STEP" "$TOTAL" \
    "$STASH" "$IS_WORKTREE" >"$CACHE_FILE"
fi

BRANCH_STRIPPED="${BRANCH#worktree-}"
# Restore / from + (Claude Code replaces / with + in worktree branch names)
[ "$BRANCH_STRIPPED" != "$BRANCH" ] && BRANCH_STRIPPED="${BRANCH_STRIPPED//+//}"

# Claude Code only sets .worktree.name for worktrees it creates itself. For any
# other linked worktree (wt, manual `git worktree add`, etc.) synthesize
# WORKTREE_NAME from the branch so the 🌳 icon still shows up.
if [ -z "$WORKTREE_NAME" ] && [ "$IS_WORKTREE" = "1" ]; then
  WORKTREE_NAME="$BRANCH_STRIPPED"
fi

# --- Worktree segment (wt_bg, only when current branch differs from worktree name) ---
# Worktrunk's default layout names the worktree dir `<repo>.<sanitize(branch)>`,
# so the leaf carries a redundant `<repo>.` prefix that already shows in the DIR
# segment. Strip it for both the display and the equivalence check, leaving just
# the branch-derived suffix. This also keeps the segment informative when the
# branch was renamed after the worktree was created (dir leaf no longer matches
# the current branch) -- only the redundant repo prefix is dropped.
WT_DISPLAY="$WORKTREE_NAME"
[ -n "$DIR" ] && WT_DISPLAY="${WT_DISPLAY#"${DIR}."}"
# Equivalence checks (pure repetition of the DIR + git segments):
#   1. Claude Code-managed: replaces / with + in worktree names, so compare
#      after normalizing both sides.
#   2. Worktrunk default layout: the stripped suffix equals the sanitized
#      branch (sanitize replaces `/` and `\` with `-`).
WT_NAME_NORM="${WT_DISPLAY//\//+}"
GIT_BRANCH_NORM="${BRANCH_STRIPPED//\//+}"
BRANCH_SANITIZED="${BRANCH_STRIPPED//\//-}"
BRANCH_SANITIZED="${BRANCH_SANITIZED//\\/-}"
WT_EQUIV_BRANCH=0
if [ -n "$WORKTREE_NAME" ]; then
  [ "$WT_NAME_NORM" = "$GIT_BRANCH_NORM" ] && WT_EQUIV_BRANCH=1
  [ "$WT_DISPLAY" = "$BRANCH_SANITIZED" ] && WT_EQUIV_BRANCH=1
fi
if [ -n "$WORKTREE_NAME" ] && [ "$WT_EQUIV_BRANCH" = "0" ]; then
  LINE="${LINE}${WT_BG}${PREV_BG_FG}${SEP}${RESET}${WT_BG}${LIGHT_FG} 🌳${WT_DISPLAY} ${RESET}"
  PREV_BG_FG="${WT_FG}"
fi

if [ -n "$BRANCH" ]; then
  GIT_STATUS=""
  # Stash count (first, matching starship ordering)
  [ "$STASH" -gt 0 ] 2>/dev/null && GIT_STATUS="${GIT_STATUS} ${ICON_STASH} ${STASH}"
  # Unstaged group: pencil-in-box then individual indicators
  UNSTAGED=""
  [ "$UNTRACKED" -gt 0 ] 2>/dev/null && UNSTAGED="${UNSTAGED}?${UNTRACKED} "
  [ "$MODIFIED" -gt 0 ] 2>/dev/null && UNSTAGED="${UNSTAGED}~${MODIFIED} "
  [ -n "$UNSTAGED" ] && GIT_STATUS="${GIT_STATUS} ${ICON_MODIFIED} ${UNSTAGED% }"
  # Staged group: check-in-box then count
  [ "$STAGED" -gt 0 ] 2>/dev/null && GIT_STATUS="${GIT_STATUS} ${ICON_STAGED} ${STAGED}"
  # Rebase/merge/cherry-pick/revert state
  if [ -n "$STATE" ]; then
    GIT_STATUS="${GIT_STATUS%"${GIT_STATUS##*[! ]}"}"
    if [ -n "$STEP" ] && [ -n "$TOTAL" ]; then
      GIT_STATUS="${GIT_STATUS} ${STATE} ${STEP}/${TOTAL}"
    else
      GIT_STATUS="${GIT_STATUS} ${STATE}"
    fi
  fi
  # Sync status: ahead/behind/diverged
  SYNC=""
  if [ "$AHEAD" -gt 0 ] 2>/dev/null && [ "$BEHIND" -gt 0 ] 2>/dev/null; then
    SYNC="⇕"
  elif [ "$AHEAD" -gt 0 ] 2>/dev/null; then
    SYNC="⇡${AHEAD}"
  elif [ "$BEHIND" -gt 0 ] 2>/dev/null; then
    SYNC="⇣${BEHIND}"
  fi
  GIT_STATUS="${GIT_STATUS%"${GIT_STATUS##*[! ]}"}" # trim trailing spaces
  [ -n "$SYNC" ] && GIT_STATUS="${GIT_STATUS} ${SYNC}"
  GIT_ICON="${ICON_BRANCH} "
  [ "$WT_EQUIV_BRANCH" = "1" ] && GIT_ICON="🌳"
  LINE="${LINE}${GIT_BG}${PREV_BG_FG}${SEP}${RESET}${GIT_BG}${LIGHT_FG} ${GIT_ICON}${BRANCH_STRIPPED}${GIT_STATUS} ${RESET}"
  PREV_BG_FG="${GIT_FG}"
fi

# --- Context segment ---
if [ "$PCT" -ge 90 ]; then
  CTX_BG="$CTX_BG_RED"
  CTX_FG_OUT="$CTX_FG_RED"
elif [ "$PCT" -ge 70 ]; then
  CTX_BG="$CTX_BG_YELLOW"
  CTX_FG_OUT="$CTX_FG_YELLOW"
else
  CTX_BG="$CTX_BG_GREEN"
  CTX_FG_OUT="$CTX_FG_GREEN"
fi

LINE="${LINE}${CTX_BG}${PREV_BG_FG}${SEP}${RESET}${CTX_BG}${DARK_FG} ${PCT}% ${RESET}"
PREV_BG_FG="${CTX_FG_OUT}"

# --- Cost segment (env_bg, --cost only) ---
# Last, and in env_bg, so the bar is bookended by the neutral grey the model
# segment opens with -- the same place and colour starship gives the clock. It
# is also the only segment that only grows, so keeping it at the end stops it
# shifting everything else sideways as the session runs on.
if [ "$SHOW_COST" = "1" ]; then
  # Cents, not the raw float: %.2f both rounds and fixes the width, so the
  # segment stops re-flowing the bar on every render.
  printf -v COST_DISPLAY '$%.2f' "$COST"
  LINE="${LINE}${ENV_BG}${PREV_BG_FG}${SEP}${RESET}${ENV_BG}${LIGHT_FG} ${COST_DISPLAY} ${RESET}"
  PREV_BG_FG="${ENV_FG}"
fi

# --- Right cap ---
# Its own step rather than a tail on whichever segment happens to be last: it
# closes the line in whatever colour PREV_BG_FG carries, so a segment appended
# after this point needs no edit here. Mirrors the left cap on the model
# segment, which is already separate for the same reason.
LINE="${LINE}${PREV_BG_FG}${SEP_ROUND_R}${RESET}"

printf '%b\n' "$LINE"
