#!/usr/bin/env bash
#
# Captures every session, window and pane on the current multiplexer server --
# name, layout, cwd -- so psmux-restore can rebuild it after a reboot. Knows
# nothing about Claude Code or hooks: pane-session backgrounds a call to this
# script on every successful --record/--forget, but that trigger lives there,
# not here, because "enumerate the whole server" is a psmux concern and
# "pair a pane with a Claude session" is not -- which is also why this script
# and its output live under ~/.psmux, not ~/.claude.
#
# Each pane's own record ($root/<namespace>-<paneId>.json, kept by
# pane-session under ~/.claude/panes) is cross-referenced here for the session
# id it last recorded, so a restored pane carries that id straight through to
# psmux-restore. That matters because a fresh server hands out pane ids from
# %0, so a restored pane's own live-lookup (the one `ccr` does) can never
# match anything -- it would always fall back to `--continue`, which is wrong
# the moment two panes share a directory, the exact ambiguity pane-session
# exists to avoid.
#
# Every failure is silent and exits 0, matching pane-session: this runs
# backgrounded off a hook, so nothing here should ever surface as an error on
# an otherwise-fine Claude session, and the cost of writing nothing is a
# restore that recreates panes without resuming anything in them.

root="$HOME/.claude/panes"
layout="$HOME/.psmux/layout.json"
readonly max_age_minutes=$((30 * 24 * 60))
readonly min_kept=5

while [ $# -gt 0 ]; do
  case "$1" in
  --root)
    [ $# -ge 2 ] || exit 0
    root="$2"
    shift
    ;;
  --layout)
    [ $# -ge 2 ] || exit 0
    layout="$2"
    shift
    ;;
  --namespace)
    [ $# -ge 2 ] || exit 0
    namespace_override="$2"
    shift
    ;;
  *) exit 0 ;;
  esac
  shift
done

# Beside the layout rather than under a path of its own, so --layout moves
# the history with the file it is a history of. Split with parameter
# expansion rather than `dirname`, which this script reaches before it has
# established that anything outside the shell is callable.
case "$layout" in
*/*) history_dir="${layout%/*}/layouts" ;;
*) history_dir='layouts' ;;
esac

# $TMUX is <socket>,<server pid>,<session id>. Its socket leaf names the
# server for -L *only* when the server was actually started with a matching
# -L; the ordinary, unnamed default server's own leaf happens to read
# "default" too, but `-L default` is a different, unrelated address --
# confirmed live, it reported "no server running" for a server `psmux ls`
# (bare, no -L) had just listed, and a guessed -S path fell back to whatever
# server bare invocation would have reached anyway rather than erring, which
# only looked like it worked. Bare invocation is what a real client actually
# uses to reach the unnamed default, verified live against it directly, so
# that is what a "default" namespace here falls back to as well.
#
# --namespace names the server instead, for a caller with no pane of its own:
# nothing psmux launches has a usable $TMUX, since a run-shell at server boot
# inherits whatever started the server, which names an unrelated server or
# nothing at all. Without either, the server cannot be identified and this
# writes nothing rather than guessing at one.
if [ -n "${namespace_override:-}" ]; then
  namespace="$namespace_override"

  # Only $TMUX carries the pid, so a layout taken this way records none. It
  # identifies which boot a saved layout belongs to, and an absent pid says
  # the periodic saver took it, which is true and better than a guess.
  server_pid=''
else
  [ -n "${TMUX:-}" ] || exit 0
  socket="${TMUX%%,*}"
  namespace="${socket##*/}"

  # The middle field is the server's own pid, which is what separates one
  # server's lifetime from the next -- a reboot always brings a new one.
  server_pid="${TMUX#*,}"
  server_pid="${server_pid%%,*}"
fi

# psmux ships a `tmux` shim for other tools' benefit; this repo's own psmux
# would otherwise never be reached ahead of it. tmux is tried last so this
# script is real tmux's answer too when it's what's actually running.
bin=''
for n in psmux pmux tmux; do
  bin=$(command -v "$n" 2>/dev/null) && break
done
[ -n "$bin" ] || exit 0

if [ "$namespace" = 'default' ]; then
  rows=$("$bin" list-panes -a -F \
    '#{pane_id}	#{session_name}	#{window_index}	#{window_name}	#{window_active}	#{window_layout}	#{pane_index}	#{pane_current_path}' \
    2>/dev/null) || exit 0
else
  rows=$("$bin" -L "$namespace" list-panes -a -F \
    '#{pane_id}	#{session_name}	#{window_index}	#{window_name}	#{window_active}	#{window_layout}	#{pane_index}	#{pane_current_path}' \
    2>/dev/null) || exit 0
fi
[ -n "$rows" ] || exit 0

# Every pane record goes to one jq along with the rows, rather than a jq or
# two per pane: starting a process costs about half a second on a Windows
# machine under endpoint protection, and a per-pane loop made a snapshot of
# a busy server take tens of seconds. The records are read as raw lines and
# parsed per file, so a corrupt one costs its pane the session id, as it
# always did, rather than failing the whole read.
records=()
for f in "$root"/*.json; do
  [ -f "$f" ] && records+=("$f")
done

# A row that is malformed -- too few fields, a non-numeric index -- is
# dropped on its own rather than failing the snapshot. Grouping takes two
# passes, by session and then by window index within each, because jq's
# group_by only groups by one key at a time.
grouped=$(jq -n -R --arg rows "$rows" --arg namespace "$namespace" \
  --arg root "$root" '
  (reduce inputs as $line ({}; .[input_filename] += $line + "\n")
    | map_values(try (fromjson | .sessionId // null
        | if . == "" then null else . end) catch null)) as $ids
  | [$rows | split("\n")[] | split("\t") | select(.[0] // "" | length > 0)
    | try {
        session: .[1],
        windowIndex: (.[2] | tonumber),
        windowName: .[3],
        windowActive: (.[4] == "1"),
        windowLayout: .[5],
        paneIndex: (.[6] | tonumber),
        cwd: (.[7:] | join("\t")),
        sessionId: $ids[$root + "/"
          + ("\($namespace)-\(.[0])" | gsub("[^A-Za-z0-9._-]"; "_"))
          + ".json"]
      }]
  | group_by(.session) | map({
    name: .[0].session,
    windows: (group_by(.windowIndex) | map({
      index: .[0].windowIndex,
      name: .[0].windowName,
      active: .[0].windowActive,
      layout: .[0].windowLayout,
      panes: (map({index: .paneIndex, cwd: .cwd, sessionId: .sessionId}) | sort_by(.index))
    }) | sort_by(.index))
  })' "${records[@]}" </dev/null 2>/dev/null) || exit 0
[ "$grouped" != '[]' ] || exit 0

mkdir -p "$(dirname "$layout")" || exit 0

# Keeps a dated copy of every layout written, so a restore that rebuilt
# nothing can be reconstructed from the one taken before the reboot. Nothing
# else holds it: the boot's own snapshot replaces the live layout within
# minutes, and the per-pane records cannot stand in, since a new server hands
# out pane ids from %1 and the sessions started after the reboot overwrite
# the records naming the panes open before it. Each name carries the writing
# process's pid as well as the second, because a SessionEnd and the
# SessionStart replacing it land together and a name of only the timestamp
# would lose one of the pair. Kept by age rather than by count: a busy boot
# takes a dozen snapshots in an hour, which would push a pre-reboot layout
# out of any list short enough to be worth keeping.
#
# What a restore actually reads, with keys sorted so two equal trees compare
# equal. `saved` and `serverPid` are left out on purpose: they differ on
# every save and between the periodic saver and a Claude session, so
# comparing whole files would find a difference each time and defeat the
# skip below.
layout_content() {
  jq -S -c '{namespace, sessions}' "$1" 2>/dev/null
}

keep_in_history() {
  mkdir -p "$history_dir" 2>/dev/null || return 0

  # A save repeating the newest entry is dropped: with a snapshot every
  # fifteen minutes, an idle machine would otherwise write ninety-odd
  # identical copies a day. tmux-resurrect drops a save matching its `last`
  # for the same reason. Names sort chronologically, so the newest entry is
  # the last the glob yields. An unreadable comparison keeps the save, the
  # cheaper way to be wrong.
  local entries newest previous current
  entries=("$history_dir"/layout-*.json)
  newest="${entries[${#entries[@]} - 1]}"
  if [ -e "$newest" ]; then
    previous=$(layout_content "$newest")
    current=$(layout_content "$layout")
    [ -n "$current" ] && [ "$previous" = "$current" ] && return 0
  fi

  cp -f "$layout" \
    "$history_dir/layout-$(date -u +%Y%m%d-%H%M%S)-$$.json" 2>/dev/null
  return 0
}

# Drops history past the retention window, matching the one pane-session
# keeps its own records for. Only files this script names are considered,
# and a file whose age cannot be read is kept: this runs unattended against
# a directory under the user's home, where deleting on a failed read is the
# more expensive way to be wrong.
#
# Ages come from a single `find` rather than a `stat` per entry. Starting a
# process costs about half a second on a Windows machine under endpoint
# protection, and with a month of history a per-entry `stat` made each
# snapshot take minutes. `-mmin` and `-maxdepth` are the same on GNU and BSD
# `find`, where `stat` needed a different flag on each.
sweep_history() {
  [ -d "$history_dir" ] || return 0

  # Names lead with the timestamp, so the glob yields them oldest first and
  # the newest are simply the tail of the list. Those are kept however old
  # they are, tmux-resurrect's rule and for its reason: a machine left alone
  # past the window would otherwise have its entire history swept on the
  # next boot, which is the one moment the history is wanted.
  local entries
  entries=("$history_dir"/layout-*.json)
  [ -e "${entries[0]}" ] || return 0

  local sweepable
  sweepable=$((${#entries[@]} - min_kept))
  [ "$sweepable" -gt 0 ] || return 0

  # Newline-delimited and wrapped in newlines, so each entry below is matched
  # as a whole line rather than as a substring of a longer name.
  local stale
  stale=$(find "$history_dir" -maxdepth 1 -name 'layout-*.json' \
    -mmin +"$max_age_minutes" 2>/dev/null) || return 0
  stale=$'\n'"$stale"$'\n'

  local doomed=() i
  for ((i = 0; i < sweepable; i++)); do
    case "$stale" in *$'\n'"${entries[i]}"$'\n'*) doomed+=("${entries[i]}") ;; esac
  done
  [ "${#doomed[@]}" -gt 0 ] && rm -f "${doomed[@]}" 2>/dev/null
  return 0
}

# Written aside and moved so a restore reading mid-write never sees a
# half-written file.
staging="$layout.$$"
namespace="$namespace" saved="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
serverPid="$server_pid" \
  jq -n --argjson sessions "$grouped" \
  '{namespace: $ENV.namespace, saved: $ENV.saved,
    serverPid: (if $ENV.serverPid == "" then null else $ENV.serverPid end),
    sessions: $sessions}' \
  >"$staging" 2>/dev/null &&
  mv -f "$staging" "$layout" 2>/dev/null &&
  keep_in_history
sweep_history
rm -f "$staging" 2>/dev/null
