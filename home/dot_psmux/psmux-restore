#!/usr/bin/env bash
#
# Rebuilds the layout psmux-snapshot captured -- sessions, windows, panes,
# the saved layout actually applied -- then resumes each pane's own
# conversation directly: `claude --resume <id>`, not `ccr`/`--continue`.
# A freshly restored pane's own live lookup (the one `ccr` does) can never
# match anything, because a new server hands out pane ids from %0; falling
# back to `--continue` there is wrong the instant two restored panes share a
# directory, which is exactly the ambiguity this whole chain exists to avoid.
#
# Every session/window/pane index used here is the one psmux just reported
# for what it created (`-P -F`), never the number that happened to be saved
# for it. A saved index describes the server that no longer exists; renumber-
# windows, a different base-index, or simply creating things in a different
# server generation can all make it stale, and psmux already hands back the
# real one for free.
#
# The session psmux creates at boot is adopted rather than skipped. psmux
# names it from the same `last_session` the layout was saved under, and has it
# running before this script issues its first command -- measured live at 1.3s
# ahead -- so a guard that skipped every existing session skipped the only
# session a single-session layout holds, every boot. A session holding more
# than one pane, or a lone pane that never sits idle at its shell, is
# someone's work rather than that placeholder, and is still left alone. Run
# from `dot_tmux.conf.tmpl`, which psmux reads exactly once per server
# lifetime, so this never re-fires on a later attach; the caller backgrounds
# it so a slow or many-paned restore never delays that attach.
#
# Every failure is silent: a session or two failing to come back is nothing
# to interrupt over, since psmux itself is already usable by the time this
# runs.
#
# Starting a process is the cost that matters here: Git Bash under endpoint
# protection takes 70-100ms to start one, and a psmux call answered by the
# server 400-800ms. So the layout is read with one jq, every pane is created
# before any is waited on, and one `list-panes -a` per poll watches them all.
#
# Nothing is typed into a pane until its shell is reading. Keys sent earlier
# are lost: of five panes typed into as they started together, none ran the
# line, and five profiles starting at once took 20-30s to reach a prompt
# where one alone takes 3.5s. A pane is ready once it is idle at its shell
# with the cursor past column 0, which is the prompt having been drawn: the
# shell is the foreground process from the moment it starts, so that alone
# says nothing. Each pane gets one line, `cd` and `claude --resume` joined,
# because a second line sent during startup was lost where the first ran.

layout="$HOME/.psmux/layout.json"
idle_timeout=120
readonly poll_interval=0.5

while [ $# -gt 0 ]; do
  case "$1" in
  --layout)
    [ $# -ge 2 ] || exit 0
    layout="$2"
    shift
    ;;
  --idle-timeout)
    [ $# -ge 2 ] || exit 0
    idle_timeout="$2"
    shift
    ;;
  *) exit 0 ;;
  esac
  shift
done

bin=''
for n in psmux pmux tmux; do
  bin=$(command -v "$n" 2>/dev/null) && break
done
[ -n "$bin" ] || exit 0

# Read once, before anything else. Claude sessions started on this server
# snapshot it into the same file while the restore is still running, and a
# restore that read the file again between steps would rebuild from what this
# server already holds rather than from what the last one left behind.
layout_json=$(<"$layout") 2>/dev/null || exit 0

# The whole layout as one record per line, tab-separated, from a single jq:
#   N <namespace>
#   S <session name>
#   W <active> <panes> <layout string> <window name>
#   P <session id, or - for none> <cwd>
# The free-text field goes last on each line, so `read` hands it over whole
# whatever it holds, and no field is ever empty, since `read` collapses
# consecutive tabs. jq's @tsv is no use here: it escapes the backslashes in
# every Windows path.
plan=$(printf '%s' "$layout_json" | jq -r '
  ["N", (.namespace // "default")],
  (.sessions[] | ["S", .name],
    (.windows[] | ["W", (.active | tostring), (.panes | length | tostring),
        .layout, .name],
      (.panes[] | ["P", (.sessionId // "-"), .cwd])))
  | join("\t")' 2>/dev/null) || exit 0

# jq on Windows ends its lines with CRLF, and a carriage return left on the
# last field of each record would ride into every session name and cwd.
plan="${plan//$'\r'/}"

namespace=$(printf '%s\n' "$plan" | sed -n '1s/^N\t//p')

# `-L <name>` only reaches a server actually started with a matching -L; the
# ordinary, unnamed default server's own socket leaf happens to read
# "default" too, but `-L default` is a different, unrelated address --
# confirmed live, it reported "no server running" for a server bare psmux
# (no -L) had just listed. Bare invocation is what a real client uses to
# reach the unnamed default, so a "default" namespace falls back to that
# rather than trying to name it.
if [ "$namespace" = 'default' ]; then
  p() { "$bin" "$@"; }
else
  p() { "$bin" -L "$namespace" "$@"; }
fi

# The bare name pane_current_command reports for psmux's default-shell
# (`pwsh` for `C:\...\pwsh.exe`), asked for once and only once there is a
# server to answer.
shell=''
default_shell() {
  if [ -z "$shell" ]; then
    shell=$(p show-options -gv default-shell 2>/dev/null)
    shell="${shell##*[/\\]}"
    shell="${shell%.[eE][xX][eE]}"
  fi
  [ -n "$shell" ]
}

# Waits for an existing session to show itself as the placeholder psmux
# creates at boot: a single pane idle at its default-shell. Prints that
# pane's window.pane index and succeeds once it does. Fails at once for a
# session holding a second pane, which nothing but the user puts there, and
# after $idle_timeout seconds for a lone pane that never sits at the shell.
#
# One look is not enough. The restore can arrive while the shell is still
# running its profile, whose `mise activate` was the foreground process 1.5s
# after a live boot, and a pane judged then looked busy and lost its whole
# session. Nor is the pane count alone: it cannot tell the placeholder from a
# pane the user has started Claude in while this restore was on its way.
wait_for_placeholder() {
  local listed deadline=$((SECONDS + idle_timeout))
  default_shell || return 1
  while :; do
    listed=$(p list-panes -s -t "$1" \
      -F '#{pane_current_command} #{window_index}.#{pane_index}' 2>/dev/null)
    case "$listed" in '' | *$'\n'*) return 1 ;; esac
    if [ "${listed% *}" = "$shell" ]; then
      printf '%s\n' "${listed##* }"
      return 0
    fi
    [ "$SECONDS" -lt "$deadline" ] || return 1
    sleep "$poll_interval"
  done
}

# Lines to type, each into its own pane once that pane's shell is reading,
# in matching order.
send_targets=()
send_lines=()

queue_line() {
  send_targets+=("$1")
  send_lines+=("$2")
}

# Types every queued line as its pane becomes ready, watching all of them
# with one `list-panes -a` per poll. A pane still not ready after
# $idle_timeout seconds is given up on. The shell check also covers the
# adopted pane: one where the user started something while this waited is
# left alone.
type_when_ready() {
  [ "${#send_targets[@]}" -gt 0 ] || return 0
  default_shell || return 0

  local deadline=$((SECONDS + idle_timeout)) i listed line rest
  local target command cursor
  while :; do
    listed=$(p list-panes -a \
      -F '#{session_name}:#{window_index}.#{pane_index} #{pane_current_command} #{cursor_x}' \
      2>/dev/null)
    while IFS= read -r line; do
      cursor="${line##* }"
      rest="${line% *}"
      command="${rest##* }"
      target="${rest% *}"
      [ "$command" = "$shell" ] || continue
      case "$cursor" in '' | *[!0-9]* | 0) continue ;; esac
      for i in "${!send_targets[@]}"; do
        [ "${send_targets[i]}" = "$target" ] || continue
        p send-keys -t "$target" "${send_lines[i]}" Enter
        unset 'send_targets[i]' 'send_lines[i]'
      done
    done <<<"$listed"

    [ "${#send_targets[@]}" -gt 0 ] || return 0
    [ "$SECONDS" -lt "$deadline" ] || return 0
    sleep "$poll_interval"
  done
}

# State for the session and window being built. A window is created on its
# first P record rather than its W, because a new window or session starts in
# its first pane's directory.
session='' session_skipped='' session_windows=0 active_window='' adopted=''
window_name='' window_layout='' window_active='' window_panes=0
window_index='' pane_count=0

finish_window() {
  if [ "$window_panes" -gt 1 ] && [ -n "$window_index" ]; then
    p select-layout -t "$session:$window_index" "$window_layout"
  fi
}

# Which window to leave the session on, selected once every window exists:
# `new-window` switches to what it creates, so selecting any earlier would be
# undone by the next one. A session of one window needs no selecting.
finish_session() {
  [ -n "$session" ] && [ -z "$session_skipped" ] || return 0
  finish_window
  if [ "$session_windows" -gt 1 ] && [ -n "$active_window" ]; then
    p select-window -t "$session:$active_window"
  fi
}

start_session() {
  finish_session
  session="$1" session_skipped='' session_windows=0 active_window=''
  window_index='' window_panes=0 adopted=''

  # A session already on the server is adopted only while it is still the
  # boot placeholder. Anything else belongs to whoever built it -- a session
  # restored by an earlier run included -- and writing into it would
  # duplicate every pane and send `cd` into a shell someone is using.
  #
  # default_shell is asked here rather than inside wait_for_placeholder, whose
  # output is captured in a subshell that would keep the answer to itself.
  p list-panes -s -t "$session" -F '#{pane_id}' >/dev/null 2>&1 || return 0
  if ! default_shell || ! adopted=$(wait_for_placeholder "$session"); then
    session_skipped=1
  fi
}

start_window() {
  finish_window
  window_active="$1" window_panes="$2" window_layout="$3" window_name="$4"
  window_index='' pane_count=0
  session_windows=$((session_windows + 1))
}

add_pane() {
  local session_id="$1" cwd="$2" created resume=''
  [ "$session_id" = '-' ] || resume="claude --resume $session_id"
  pane_count=$((pane_count + 1))

  if [ "$pane_count" -gt 1 ]; then
    created=$(p split-window -t "$session:$window_index" -c "$cwd" \
      -P -F '#{pane_index}' 2>/dev/null) || return 0
    [ -z "$resume" ] || queue_line "$session:$window_index.$created" "$resume"
    return 0
  fi

  if [ -n "$adopted" ]; then
    # The placeholder's shell started wherever psmux put it, and
    # `claude --resume` finds a conversation only from the directory that
    # recorded it; every other pane is born in its own (`-c`).
    created="$adopted"
    adopted=''
    p rename-window -t "$session:${created%.*}" "$window_name"
    queue_line "$session:$created" "cd '$cwd'${resume:+; $resume}"
  elif [ "$session_windows" -eq 1 ]; then
    created=$(p new-session -d -s "$session" -n "$window_name" -c "$cwd" \
      -P -F '#{window_index}.#{pane_index}' 2>/dev/null) || return 0
    [ -z "$resume" ] || queue_line "$session:$created" "$resume"
  else
    created=$(p new-window -t "$session" -n "$window_name" -c "$cwd" \
      -P -F '#{window_index}.#{pane_index}' 2>/dev/null) || return 0
    [ -z "$resume" ] || queue_line "$session:$created" "$resume"
  fi

  window_index="${created%.*}"
  [ "$window_active" = 'true' ] && active_window="$window_index"
}

while IFS=$'\t' read -r kind a b c d; do
  case "$kind" in
  S) start_session "$a" ;;
  W) [ -n "$session_skipped" ] || start_window "$a" "$b" "$c" "$d" ;;
  P) [ -n "$session_skipped" ] || add_pane "$a" "$b" ;;
  esac
done <<<"$plan"
finish_session

type_when_ready
exit 0
