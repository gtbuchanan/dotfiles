# Vim defaults to `vimfiles` instead of .vim on Windows
vimfiles

# Copilot and Codex both discover skills via ~/.agents/skills now
.codex/skills
.copilot/skills

# Skills moved from ~/.config/skills to ~/.agents/skills as the canonical location
.config/skills

# Worktree manager swapped from timvw/wt to max-sixty/worktrunk — drop the
# old config directories (new ones live under ~/.config/worktrunk/ and
# %APPDATA%\worktrunk\) and the obsolete wt-cleanup helper.
.config/wt
AppData/Roaming/wt
.local/bin/wt-cleanup
.local/bin/wt-cleanup.bat
.local/bin/wt-cleanup.ps1
.local/bin/wt-bootstrap.bat
.local/bin/wt-bootstrap.ps1
.agents/skills/wt

# The hass-cli wrapper replaced the mise [env] fragment that used to supply
# HASS_SERVER/HASS_TOKEN. Dropping it from the source only stops chezmoi
# managing it, so a host that already has it would keep exporting the token to
# everything mise spawns — the exact exposure the wrapper closes.
.config/mise/conf.d/home-assistant-credentials.toml
