#MISE depends=["test:templates"]
#
# Deliberately body-less: the leaves listed above are the whole of it, and mise
# resolves them.
#
# It exists so CI names a tier rather than a tool. A leaf is named for what runs
# it -- test:templates for the render, and a unit-test runner would be
# test:<runner> -- and joining the aggregate is one entry here. The job that
# calls this never has to change, so adding coverage costs no CI edit and no new
# required status check.
#
# The Termux tier is separate (test:termux), because it needs a container on any
# host that is not a phone.
