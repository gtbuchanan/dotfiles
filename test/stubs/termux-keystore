#!/usr/bin/env bash
#
# A MODEL of termux-keystore, so test/hass_vault_test.sh can run somewhere other
# than a phone. termux-keystore talks to Termux:API, which needs the Termux:API
# app on a real device, and the termux-docker userland the android CI leg
# borrows has no Android API service to answer it. Without this the suite skips
# there and proves only that the file parses.
#
# WHAT THIS IS AND IS NOT
#
# The keystore is a *dependency* of nearly every test but the *subject* of only
# three. Seeding a cache needs some key to exist; asserting that a rotated token
# is picked up does not care what kind of key it was. So this unblocks the
# majority of the suite without pretending to be a hardware keystore.
#
# It is a model, and green tests mean "correct against this model". The claims
# it makes are listed below so they can be re-checked against a real device;
# `mise run test:shunit2` on a phone remains the authority on whether they still
# hold. What it deliberately does NOT model: hardware backing, key
# non-extractability, biometric gating, and the cost of the Termux:API IPC.
#
# THE CLAIMS
#
# 1. `sign` on a MISSING alias writes nothing and exits 0. This is the whole
#    reason the binding tests exist: a resolver that signs without checking gets
#    0 bytes, folds them to sha256("") and uses that public constant as its KEK
#    -- identically on write and read, so the cache round-trips perfectly while
#    bound to nothing. Reproducing it exactly is what keeps
#    test_the_cache_does_not_open_under_the_empty_signature_key load-bearing
#    rather than vacuous.
# 2. `sign` on a known alias is deterministic for the same alias and input, so
#    a cache sealed on one call opens on the next.
# 3. Distinct aliases produce distinct signatures, so a cache is bound to the
#    alias it was sealed under.
# 4. `list` emits a JSON array of objects carrying `.alias`.
# 5. `generate` is idempotent, and `delete` on a missing alias is not an error.
#
# The signature is a hex digest rather than the ~256 raw bytes a real RSA
# signature would be. The resolver only ever pipes it through sha256sum, so the
# width is immaterial; what matters is that it is non-empty, stable, and
# alias-dependent.
set -euo pipefail

# Device-wide in reality, so a fixed location per run rather than something
# scoped to one test -- which is what lets `list` and `delete` behave as the
# suite expects across invocations.
readonly STORE="${TERMUX_KEYSTORE_STUB_DIR:-${TMPDIR:-/tmp}/termux-keystore-stub}"

# Aliases reach the filesystem, so refuse anything that is not a plain label
# rather than letting it escape the store.
key_path() {
  case "$1" in
  '' | *[!A-Za-z0-9._-]* | .*)
    printf 'stub: unsupported alias %s\n' "$1" >&2
    exit 2
    ;;
  esac
  printf '%s/%s' "$STORE" "$1"
}

case "${1:-}" in
generate)
  # Extra flags (-a RSA -s 2048) are accepted and ignored: the stub has no
  # algorithm to choose, and rejecting them would make it fail where the real
  # command succeeds.
  mkdir -p "$STORE"
  : >"$(key_path "${2:?alias required}")"
  ;;

list)
  mkdir -p "$STORE"
  first=1
  printf '['
  for key in "$STORE"/*; do
    [ -e "$key" ] || continue
    [ "$first" -eq 1 ] || printf ','
    first=0
    printf '{"alias":"%s","algorithm":"RSA"}' "${key##*/}"
  done
  printf ']\n'
  ;;

sign)
  path=$(key_path "${2:?alias required}")
  # Claim 1. Silence and success, exactly as the real command reports a missing
  # alias -- NOT an error, which is what makes the trap a trap.
  [ -e "$path" ] || exit 0
  # Claims 2 and 3: stable, and bound to the alias.
  {
    printf 'termux-keystore-stub/%s/' "$2"
    cat
  } | sha256sum | cut -d' ' -f1
  ;;

delete)
  rm -f "$(key_path "${2:?alias required}")"
  ;;

*)
  printf 'stub: unknown command %s\n' "${1:-}" >&2
  exit 2
  ;;
esac
