{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^home/\\.chezmoidata/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n[ \\t]*\\S+:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.yaml\\.tmpl$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[\\w-]+/[\\w.-]+)/archive/refs/tags/(?<currentValue>[\\w.-]+)\\.tar\\.gz"
      ]
    },
    {
      "currentValueTemplate": "main",
      "customType": "regex",
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "https://github.com/{{depName}}",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.yaml\\.tmpl$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[\\w-]+/[\\w.-]+)/archive/(?<currentDigest>[a-f0-9]{40})\\.tar\\.gz"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "nuget",
      "managerFilePatterns": [
        "/^powershell-modules\\.psd1$/"
      ],
      "matchStrings": [
        "(?<depName>\\w[\\w.]*)\\s*=\\s*'(?<currentValue>[^']+)'"
      ],
      "registryUrlTemplate": "https://www.powershellgallery.com/api/v2/"
    }
  ],
  "extends": [
    "local>gtbuchanan/tooling"
  ],
  "mise": {
    "description": "The deployed global mise fragments live under a chezmoi `dot_config` source path, which the manager's built-in patterns (keyed on a literal `.config`) can't match. Every fragment is kept as plain TOML rather than a chezmoi template so this manager can parse it, which is what makes per-dep `# renovate:` annotations unnecessary there; docs/mise.md carries the rationale. managerFilePatterns is additive, so the repo-root mise.toml keeps matching by default.",
    "managerFilePatterns": [
      "/^home/dot_config/mise/conf\\.d/.+\\.toml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Restrict noisy agent-skill digest updates to a single early-morning window on the 1st and 15th (America/Chicago). The narrow window keeps the snapshot of `main` to one PR per dep per cycle: daytime merges fall outside it, so a freshly-advanced `main` can't trigger a same-day follow-up PR.",
      "matchDatasources": [
        "git-refs"
      ],
      "matchFileNames": [
        "home/.chezmoiexternal.yaml.tmpl"
      ],
      "minimumReleaseAge": "0 days",
      "schedule": [
        "* 0-5 1,15 * *"
      ]
    }
  ]
}
